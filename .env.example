# Copy to `.env` and fill in real secrets.
# .env is git-ignored.

# ── MySQL ─────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootdev

# ── AI Provider keys (for token-api to call the real APIs) ────────
# Local dev can leave these as DUMMY — calls will fail with 401,
# but everything else (auth, ledger, X402) works.
ANTHROPIC_API_KEY=sk-ant-DUMMY
OPENAI_API_KEY=sk-DUMMY
XAI_API_KEY=DUMMY
GOOGLE_API_KEY=DUMMY

# ── Console ───────────────────────────────────────────────────────
# Must be at least 32 chars for next-auth in production; ok for local dev.
NEXTAUTH_SECRET=localdevsecret_change_in_real_env_min_32_chars

# ── SDK test wallet (for examples/quickstart.py) ──────────────────
# Generate with: solana-keygen new -o ~/.netstars/wallet.json
NETSTARS_WALLET_PATH=~/.netstars/wallet.json
NETSTARS_API_KEY=ak_localdev_test
NETSTARS_API_KEY_SECRET=secret_localdev_test

# ── Inter-service auth (token-api ↔ x402-api) ─────────────────────
# Shared secret used for X-Internal-Auth header. Rotate per environment;
# in QA/prod we'd source this from AWS Secrets Manager via ESO.
INTERNAL_AUTH_SECRET=internal_localdev_token

# ── Solana / USDC (x402-api real-chain path) ──────────────────────
# USDC mint. Devnet default is Circle's test mint. For a fully local
# Solana validator, `spl-token create-token` and put the new mint here.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Deposit recipient: wallet (owner) whose USDC ATA receives payments.
# Replace with your local-validator wallet pubkey for real-chain testing.
DEPOSIT_RECIPIENT_ADDRESS=5dHJpDeM4kvNSnSqkA2D9wmJZ5fHZ3iH3a6CkZxJ2hYz

# ── Webhooks (x402-api outbound) ──────────────────────────────────
# Where to POST payment events. Default loops back to x402's own /dev/webhook-sink
# so a single-compose demo can show the full round-trip. Point this at your
# merchant endpoint to receive real deliveries.
WEBHOOK_DEFAULT_URL=http://x402-api:8080/dev/webhook-sink
# Per-environment HMAC secret used to sign every outbound delivery.
WEBHOOK_SIGNING_SECRET=whsec_localdev_change_me
WEBHOOK_MAX_ATTEMPTS=6

# ── KMS (token-api agent-key secret encryption) ───────────────────
# KMS_MODE=dev (default) treats the agent_keys.key_secret_enc column as
# plaintext bytes — fine for local. For QA/prod, set KMS_MODE=aws and grant
# the pod's IRSA role kms:Decrypt on AWS_KMS_KEY_ALIAS. boto3 picks up creds
# via the standard credential chain (IRSA in EKS / SSO locally).
KMS_MODE=dev
AWS_REGION=ap-northeast-1
# alias/<name> or arn:aws:kms:... — only needed for KMS_MODE=aws + the encrypt CLI
AWS_KMS_KEY_ALIAS=
